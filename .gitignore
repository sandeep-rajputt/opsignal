# ===========================
# Root Gitignore (Monorepo)
# frontend/  → Next.js 16
# backend/   → Node.js + Express + TS
# ===========================

# --- Node modules (both frontend & backend) ---
node_modules/

# --- Environment files ---
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS & Editor files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- TypeScript Build Output (backend) ---
backend/dist/
backend/build/
backend/out/
backend/*.tsbuildinfo

# --- Next.js Build Output (frontend) ---
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.turbo/

# --- Next.js Cache ---
frontend/node_modules/.cache/
frontend/.eslintcache

# --- Temp Files ---
tmp/
temp/

# --- Coverage ---
coverage/
frontend/coverage/
backend/coverage/

# --- Misc ---
*.pid
*.seed
*.pid.lock
